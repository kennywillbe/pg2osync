{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "cebbab9ba93899d69a029f388b76b51274ba6f9e",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "always-update": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "component": "pg2osync",
      "changelog-path": "crates/bin/CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/bin/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='pg2osync')].version"
        },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/deployment.md" },
        { "type": "generic", "path": "examples/docker-compose.yml" },
        { "type": "generic", "path": "deploy/docker-compose.yml" },
        { "type": "generic", "path": "deploy/helm/pg2osync/Chart.yaml" },
        { "type": "generic", "path": "deploy/kubernetes/kustomization.yaml" },
        { "type": "generic", "path": "deploy/kubernetes/deployment.yaml" },
        { "type": "generic", "path": "deploy/operator/kustomization.yaml" },
        { "type": "generic", "path": "deploy/operator/deployment.yaml" }
      ]
    }
  }
}
