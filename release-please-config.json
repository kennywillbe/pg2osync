{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "bootstrap-sha": "66f780cfc2ee21b586a2e910678c4aff9f8ba763",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "packages": {
    "crates/bin": {
      "component": "pg2osync"
    },
    "crates/core": {
      "component": "pg2osync-core",
      "skip-changelog": true,
      "skip-github-release": true
    },
    "crates/engine": {
      "component": "pg2osync-engine",
      "skip-changelog": true,
      "skip-github-release": true
    },
    "crates/sink": {
      "component": "pg2osync-sink",
      "skip-changelog": true,
      "skip-github-release": true
    },
    "crates/source": {
      "component": "pg2osync-source",
      "skip-changelog": true,
      "skip-github-release": true
    },
    "crates/source-mysql": {
      "component": "pg2osync-source-mysql",
      "skip-changelog": true,
      "skip-github-release": true
    },
    "crates/tls": {
      "component": "pg2osync-tls",
      "skip-changelog": true,
      "skip-github-release": true
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "pg2osync",
      "components": [
        "pg2osync",
        "pg2osync-core",
        "pg2osync-engine",
        "pg2osync-sink",
        "pg2osync-source",
        "pg2osync-source-mysql",
        "pg2osync-tls"
      ]
    }
  ]
}
